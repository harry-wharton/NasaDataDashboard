@inherits LayoutComponentBase

<!-- MudBlazor Providers, applies theme and support for various things -->
<MudThemeProvider Theme="_theme" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<!-- Main Layout Structure -->
<MudLayout>
    <!-- Nav Bar -->
    <MudAppBar Elevation="4" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" />
        <MudText Typo="Typo.h5" Class="ml-3 font-weight-bold">Data Dashboard</MudText>
        <MudSpacer />
        <MudButton Href="/asteroid3d" 
           Variant="Variant.Text" 
           Color="Color.Inherit" 
           StartIcon="@Icons.Material.Filled.Language">3D View
        </MudButton>    
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       OnClick="ToggleTheme" />
        <MudIconButton Icon="@Icons.Material.Filled.MoreVert" />
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>

@code {
    // Can alter this for custom theme
    // Color codes AI generated for a "NASA" theme
    private bool _isDarkMode = true;
    private MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#0B3D91",     // deep blue
            Secondary = "#FC3D21",   // red accent
            Background = "#F4F6FA",  // light neutral background
            Surface = "#FFFFFF"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#58A6FF",     // bright space blue
            Secondary = "#FF6B4A",   // warm red accent
            Background = "#0D1117",  // space black/blue background
            Surface = "#161B22"
        }
    };
    private void ToggleTheme() => _isDarkMode = !_isDarkMode;
}