@page "/asteroid3d"
@inject NavigationManager Navigation
@inject Data.Services.NasaApiService NasaApiService
@inject IJSRuntime JS

<PageTitle>3D Asteroid Visualization</PageTitle>

<!-- Back Button Overlay -->
<div style="position: fixed; top: 20px; left: 20px; z-index: 1000;">
    <MudButton Variant="Variant.Filled" 
               Color="Color.Primary" 
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="ReturnToDashboard"
               Style="backdrop-filter: blur(10px); background-color: rgba(13, 17, 23, 0.9);">
        Back to Dashboard
    </MudButton>
</div>

@if (_loading)
{
        <div style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 999;">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6" Class="mt-2" Style="color: white;">Loading asteroid data...</MudText>
        </div>
}

<div style="width: 100vw; height: 100vh; margin: 0; padding: 0; position: fixed; top: 0; left: 0;">
    <iframe id="asteroid3d-frame" 
            src="/3d-viewer.html" 
            style="width: 100%; height: 100%; border: none;">
    </iframe>
</div>

@code {
    private bool _loading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Fetch asteroid data from NASA API
                var asteroids = await NasaApiService.GetNeoAsync();

                // Transform data for 3D visualization
                var asteroidData = asteroids.Select(a => new
                {
                    id = a.Id,
                    name = a.Name,
                    distance = (double)(a.DistanceFromEarth / 1000000m), // Convert to millions of km
                    velocity = (double)a.Velocity,
                    // Calculate size based on estimated diameter (you may need to add this to your AsteroidData model)
                    size = 1.5, // Default size, adjust based on your data
                    isPotentiallyHazardous = false // Add this field to your model if available
                }).ToList();

                // Send data to iframe
                await JS.InvokeVoidAsync("sendAsteroidDataToIframe", asteroidData);

                _loading = false;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading asteroid data: {ex.Message}");
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private void ReturnToDashboard()
    {
        Navigation.NavigateTo("/");
    }
}