@page "/"

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h3" Class="mb-4 text-center font-weight-bold">Near-Earth Object Tracker</MudText>

<MudCard Class="mb-4">
	<MudCardContent>
		<MudGrid>
			<MudItem xs="12" md="4">
				<MudTextField @bind-Value="_searchString" 
							  Label="Search by Name or ID" 
							  Variant="Variant.Outlined"
							  Adornment="Adornment.Start" 
							  AdornmentIcon="@Icons.Material.Filled.Search" />
			</MudItem>
			<MudItem xs="12" md="4">
				<MudNumericField @bind-Value="_minDistance" 
								 Label="Min Distance (M km)" 
								 Variant="Variant.Outlined" 
								 Min="0" />
			</MudItem>
			<MudItem xs="12" md="4">
				<MudNumericField @bind-Value="_maxDistance" 
								 Label="Max Distance (M km)" 
								 Variant="Variant.Outlined" 
								 Min="0" />
			</MudItem>
			<MudItem xs="12" md="4">
				<MudNumericField @bind-Value="_minVelocity" 
								 Label="Min Velocity (km/h)" 
								 Variant="Variant.Outlined" 
								 Min="0" />
			</MudItem>
			<MudItem xs="12" md="4">
				<MudNumericField @bind-Value="_maxVelocity" 
								 Label="Max Velocity (km/h)" 
								 Variant="Variant.Outlined" 
								 Min="0" />
			</MudItem>
			<MudItem xs="12" md="4" Class="d-flex align-center">
				<MudButton Variant="Variant.Filled" 
						   Color="Color.Primary" 
						   OnClick="ApplyFilters" 
						   FullWidth="true"
						   StartIcon="@Icons.Material.Filled.FilterAlt">
					Apply Filters
				</MudButton>
			</MudItem>
		</MudGrid>
	</MudCardContent>
</MudCard>

@if (_loading)
{
	<MudProgressLinear Indeterminate="true" />
	<MudShimmer Lines="6" />
} else
{
	<MudGrid>
		<MudItem xs="12" md="6">
			<MudCard>
				<MudCardHeader><MudText Typo="Typo.h6">Closest Asteroids</MudText></MudCardHeader>
				<MudCardContent>
					<MudChart ChartType="ChartType.Bar"
					ChartSeries="@_distanceSeries"
					XAxisLabels="@_xAxisLabels"
					Height="500px"
					Width="100%"
					ChartOptions="_chartOptions" />
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" md="6">
			<MudCard>
				<MudCardHeader><MudText Typo="Typo.h6">Asteroid Velocity</MudText></MudCardHeader>
					<MudCardContent>
						<MudChart ChartType="ChartType.Line"
						ChartSeries="@_velocitySeries"
						XAxisLabels="@_xAxisLabels"
						Height="500px"
						Width="100%"
						ChartOptions="_chartOptions" />
					</MudCardContent>
			</MudCard>
		</MudItem>
	</MudGrid>
}

@inject Data.Services.NasaApiService nasaApiService

@code
{
	private List<ChartSeries> _distanceSeries = new();
	private List<ChartSeries> _velocitySeries = new();

	private bool _loading = true;
	private List<Data.Objects.AsteroidData> _asteroids = new();
	private string[] _xAxisLabels = Array.Empty<string>();

	private ChartOptions _chartOptions = new ChartOptions()
	{
		YAxisTicks = 10,
		YAxisLines = true,
		XAxisLines = true,
		InterpolationOption = InterpolationOption.Straight,
		YAxisFormat = "N2",
		ShowLegend = false // Hide the legend since we have custom labels
	};

	private List<Data.Objects.AsteroidData> _filteredAsteroids = new();
	private double _minDistance = 0;
	private double _maxDistance = 100;
	private double _minVelocity = 0;
	private double _maxVelocity = 100000;
	private string _searchString = "";

	protected override async Task OnInitializedAsync()
	{
		_asteroids = await nasaApiService.GetNeoAsync();
		_filteredAsteroids = _asteroids;
		_loading = false;

		UpdateCharts();
	}

	private void UpdateCharts()
	{
		// Sort by distance and take the 10 closest from filtered results
		var closestAsteroids = _filteredAsteroids
			.OrderBy(a => a.DistanceFromEarth)
			.Take(10)
			.ToList();

		// Create x axis labels
		_xAxisLabels = closestAsteroids.Select(a => a.Id).ToArray();

		// Create distance chart data
		_distanceSeries = new List<ChartSeries>
		{
			new ChartSeries
			{
				Name = "Distance",
				Data = closestAsteroids.Select(a => Math.Round((double)(a.DistanceFromEarth / 1000000m), 2)).ToArray()
			}
		};

		// Create velocity chart data
		_velocitySeries = new List<ChartSeries>
		{
			new ChartSeries
			{
				Name = "Velocity",
				Data = closestAsteroids.Select(a => Math.Round((double)(a.Velocity), 2)).ToArray()
			}
		};

		StateHasChanged(); // Force UI to re-render
	}

	private void ApplyFilters()
	{
		_filteredAsteroids = _asteroids;

		// Filter by search string (name or ID)
		if (!string.IsNullOrWhiteSpace(_searchString))
		{
			_filteredAsteroids = _filteredAsteroids.Where(a => a.Name
				.Contains(_searchString, StringComparison.OrdinalIgnoreCase) 
				|| a.Id.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
				.ToList();
		}

		// Filter by distance range (convert to millions of km)
		_filteredAsteroids = _filteredAsteroids
			.Where(a =>
			{
				var distanceInMillions = (double)(a.DistanceFromEarth / 1000000m);
				return distanceInMillions >= _minDistance && distanceInMillions <= _maxDistance;
			})
			.ToList();

		// Filter by velocity range
		_filteredAsteroids = _filteredAsteroids
			.Where(a => (double)a.Velocity >= _minVelocity && (double)a.Velocity <= _maxVelocity)
			.ToList();

		UpdateCharts();
	}

}