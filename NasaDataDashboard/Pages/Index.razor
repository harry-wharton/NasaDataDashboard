@page "/"

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h3" Class="mb-4 text-center font-weight-bold">Near-Earth Object Tracker</MudText>

<MudButton 
	Href="/asteroids"
	Variant="Variant.Filled"
	Color="Color.Primary"
	Size="Size.Large">
	View 3D Asteroids
</MudButton>

<MudCard Class="mb-4">
	<MudCardContent>
		<MudGrid>
			<MudItem xs="12" md="4">
				<MudTextField @bind-Value="_searchString" 
							  Label="Search by Name or ID" 
							  Variant="Variant.Outlined"
							  Adornment="Adornment.Start" 
							  AdornmentIcon="@Icons.Material.Filled.Search" />
			</MudItem>
			<MudItem xs="12" md="4">
				<MudSelect @bind-Value="_distanceRange" 
						   Label="Distance Range" 
						   Variant="Variant.Outlined"
						   AnchorOrigin="Origin.BottomCenter">
					<MudSelectItem Value="@("all")">All Distances</MudSelectItem>
					<MudSelectItem Value="@("0-1")">Very Close (0-1 M km)</MudSelectItem>
					<MudSelectItem Value="@("1-5")">Close (1-5 M km)</MudSelectItem>
					<MudSelectItem Value="@("5-10")">Near (5-10 M km)</MudSelectItem>
					<MudSelectItem Value="@("10-50")">Moderate (10-50 M km)</MudSelectItem>
					<MudSelectItem Value="@("50-100")">Far (50-100 M km)</MudSelectItem>
				</MudSelect>
			</MudItem>
			<MudItem xs="12" md="4">
				<MudSelect @bind-Value="_velocityRange" 
						   Label="Velocity Range" 
						   Variant="Variant.Outlined"
						   AnchorOrigin="Origin.BottomCenter">
					<MudSelectItem Value="@("all")">All Velocities</MudSelectItem>
					<MudSelectItem Value="@("0-10000")">Slow (0-10,000 km/h)</MudSelectItem>
					<MudSelectItem Value="@("10000-30000")">Moderate (10,000-30,000 km/h)</MudSelectItem>
					<MudSelectItem Value="@("30000-60000")">Fast (30,000-60,000 km/h)</MudSelectItem>
					<MudSelectItem Value="@("60000-100000")">Very Fast (60,000-100,000 km/h)</MudSelectItem>
					<MudSelectItem Value="@("100000-200000")">Extremely Fast (100,000+ km/h)</MudSelectItem>
				</MudSelect>
			</MudItem>
			<MudItem xs="12" Class="d-flex align-center justify-center">
				<MudButton Variant="Variant.Filled" 
						   Color="Color.Primary" 
						   OnClick="ApplyFilters" 
						   StartIcon="@Icons.Material.Filled.FilterAlt">
					Apply Filters
				</MudButton>
			</MudItem>
		</MudGrid>
	</MudCardContent>
</MudCard>

@if (!_loading && _filteredAsteroids.Any())
{
	<MudAlert Severity="Severity.Info" Class="mb-4">
		Showing @_filteredAsteroids.Count of @_asteroids.Count asteroids
	</MudAlert>
}

@if (_loading)
{
	<MudProgressLinear Indeterminate="true" />
	<MudShimmer Lines="6" />
} else
{
	<!-- Summary Statistics Cards -->
	<MudGrid Class="mb-4">
		<MudItem xs="12" sm="6" md="3">
			<MudCard Elevation="2">
				<MudCardContent>
					<MudText Typo="Typo.h6" Color="Color.Primary">Total NEOs</MudText>
					<MudText Typo="Typo.h3">@_filteredAsteroids.Count</MudText>
					<MudText Typo="Typo.body2" Color="Color.Secondary">Tracked Objects</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>
		<MudItem xs="12" sm="6" md="3">
			<MudCard Elevation="2">
				<MudCardContent>
					<MudText Typo="Typo.h6" Color="Color.Warning">Potentially Hazardous</MudText>
					<MudText Typo="Typo.h3">@_hazardousCount</MudText>
					<MudText Typo="Typo.body2" Color="Color.Secondary">@_hazardousPercentage% of Total</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>
		<MudItem xs="12" sm="6" md="3">
			<MudCard Elevation="2">
				<MudCardContent>
					<MudText Typo="Typo.h6" Color="Color.Info">Closest Approach</MudText>
					<MudText Typo="Typo.h3">@_closestDistance</MudText>
					<MudText Typo="Typo.body2" Color="Color.Secondary">Million km</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>
		<MudItem xs="12" sm="6" md="3">
			<MudCard Elevation="2">
				<MudCardContent>
					<MudText Typo="Typo.h6" Color="Color.Success">Avg Velocity</MudText>
					<MudText Typo="Typo.h3">@_avgVelocity</MudText>
					<MudText Typo="Typo.body2" Color="Color.Secondary">km/h</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>
	</MudGrid>

	<!-- Main Charts -->
	<MudGrid>
		<MudItem xs="12" md="6">
			<MudCard>
				<MudCardHeader><MudText Typo="Typo.h6">Closest Asteroids by Distance (Million KM)</MudText></MudCardHeader>
				<MudCardContent>
					<MudChart ChartType="ChartType.Bar"
					ChartSeries="@_distanceSeries"
					XAxisLabels="@_xAxisLabels"
					Height="400px"
					Width="100%"
					ChartOptions="_chartOptions" />
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" md="6">
			<MudCard>
				<MudCardHeader><MudText Typo="Typo.h6">Asteroid Velocity Distribution (KM/H)</MudText></MudCardHeader>
					<MudCardContent>
						<MudChart ChartType="ChartType.Line"
						ChartSeries="@_velocitySeries"
						XAxisLabels="@_xAxisLabels"
						Height="400px"
						Width="100%"
						ChartOptions="_chartOptions" />
					</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" md="6">
			<MudCard>
				<MudCardHeader><MudText Typo="Typo.h6">Size Distribution</MudText></MudCardHeader>
				<MudCardContent>
					<MudChart ChartType="ChartType.Pie"
					InputData="@_sizeSeries"
					InputLabels="@_pieLabels"
					Height="400px"
					Width="100%" />
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" md="6">
			<MudCard>
				<MudCardHeader><MudText Typo="Typo.h6">Hazard Assessment</MudText></MudCardHeader>
				<MudCardContent>
					<MudChart ChartType="ChartType.Donut"
					InputData="@_hazardSeries"
					InputLabels="@_donutLabels"
					Height="400px"
					Width="100%"/>
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12">
			<MudCard>
				<MudCardHeader><MudText Typo="Typo.h6">Distance vs Velocity Correlation</MudText></MudCardHeader>
				<MudCardContent>
					<MudChart ChartType="ChartType.Line"
					ChartSeries="@_scatterSeries"
					XAxisLabels="@_scatterLabels"
					Height="400px"
					Width="100%"
					ChartOptions="_scatterChartOptions" />
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" md="6">
			<MudCard>
				<MudCardHeader><MudText Typo="Typo.h6">Top 10 Fastest Asteroids</MudText></MudCardHeader>
				<MudCardContent>
					<MudSimpleTable Striped="true" Dense="true">
						<thead>
							<tr>
								<th>Name</th>
								<th>Velocity (km/h)</th>
								<th>Distance (M km)</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var asteroid in _fastestAsteroids)
							{
								<tr>
									<td>@asteroid.Name</td>
									<td>@Math.Round((double)asteroid.Velocity, 0).ToString("N0")</td>
									<td>@Math.Round((double)(asteroid.DistanceFromEarth / 1000000m), 2)</td>
								</tr>
							}
						</tbody>
					</MudSimpleTable>
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" md="6">
			<MudCard>
				<MudCardHeader><MudText Typo="Typo.h6">Largest Asteroids</MudText></MudCardHeader>
				<MudCardContent>
					<MudSimpleTable Striped="true" Dense="true">
						<thead>
							<tr>
								<th>Name</th>
								<th>Diameter (m)</th>
								<th>Hazardous</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var asteroid in _largestAsteroids)
							{
								<tr>
									<td>@asteroid.Name</td>
									<td>@Math.Round((double)asteroid.Diameter, 0).ToString("N0")</td>
									<td>
										@if (asteroid.IsHazardous)
										{
											<MudChip T="string" Size="Size.Small" Color="Color.Warning">Yes</MudChip>
										}
										else
										{
											<MudChip T="string" Size="Size.Small" Color="Color.Success">No</MudChip>
										}
									</td>
								</tr>
							}
						</tbody>
					</MudSimpleTable>
				</MudCardContent>
			</MudCard>
		</MudItem>
	</MudGrid>
}

@inject Data.Services.NasaApiService nasaApiService

@code
{
	private List<ChartSeries> _distanceSeries = new();
	private List<ChartSeries> _velocitySeries = new();
	private double[] _sizeSeries = [];
	private string[] _pieLabels = [];
	private double[] _hazardSeries = [];
	private string[] _donutLabels = [];
	private List<ChartSeries> _scatterSeries = new();
	private string[] _scatterLabels = Array.Empty<string>();

	private bool _loading = true;
	private List<Data.Objects.AsteroidData> _asteroids = new();
	private List<Data.Objects.AsteroidData> _filteredAsteroids = new();
	private List<Data.Objects.AsteroidData> _fastestAsteroids = new();
	private List<Data.Objects.AsteroidData> _largestAsteroids = new();
	private string[] _xAxisLabels = Array.Empty<string>();

	private string _distanceRange = "all";
	private string _velocityRange = "all";
	private string _searchString = "";

	private int _hazardousCount = 0;
	private string _hazardousPercentage = "0";
	private string _closestDistance = "0";
	private string _avgVelocity = "0";

	private ChartOptions _chartOptions = new ChartOptions()
	{
		YAxisTicks = 10,
		YAxisLines = true,
		XAxisLines = true,
		InterpolationOption = InterpolationOption.Straight,
		YAxisFormat = "N2",
		ShowLegend = false
	};

	private ChartOptions _pieChartOptions = new ChartOptions()
	{
		ShowLegend = true
	};

	private ChartOptions _donutChartOptions = new ChartOptions()
	{
		ShowLegend = true
	};

	private ChartOptions _scatterChartOptions = new ChartOptions()
	{
		YAxisTicks = 10,
		YAxisLines = true,
		XAxisLines = true,
		InterpolationOption = InterpolationOption.NaturalSpline,
		YAxisFormat = "N0",
		ShowLegend = false
	};

	protected override async Task OnInitializedAsync()
	{
		_asteroids = await nasaApiService.GetNeoAsync();
		_filteredAsteroids = _asteroids;
		_loading = false;

		UpdateCharts();
		UpdateStatistics();
	}

	private void UpdateStatistics()
	{
		_hazardousCount = _filteredAsteroids.Count(a => a.IsHazardous);
		_hazardousPercentage = _filteredAsteroids.Count > 0 
			? Math.Round((double)_hazardousCount / _filteredAsteroids.Count * 100, 1).ToString("F1")
			: "0";

		_closestDistance = _filteredAsteroids.Any() 
			? Math.Round((double)(_filteredAsteroids.Min(a => a.DistanceFromEarth) / 1000000m), 2).ToString("F2")
			: "0";

		_avgVelocity = _filteredAsteroids.Any()
			? Math.Round(_filteredAsteroids.Average(a => (double)a.Velocity), 0).ToString("N0")
			: "0";

		_fastestAsteroids = _filteredAsteroids
			.OrderByDescending(a => a.Velocity)
			.Take(10)
			.ToList();

		_largestAsteroids = _filteredAsteroids
			.OrderByDescending(a => a.Diameter)
			.Take(10)
			.ToList();
	}

	private void UpdateCharts()
	{
		var closestAsteroids = _filteredAsteroids
			.OrderBy(a => a.DistanceFromEarth)
			.Take(10)
			.ToList();

		_xAxisLabels = closestAsteroids.Select(a => a.Name).ToArray();

		_distanceSeries = new List<ChartSeries>
		{
			new ChartSeries
			{
				Name = "Distance",
				Data = closestAsteroids.Select(a => Math.Round((double)(a.DistanceFromEarth / 1000000m), 2)).ToArray()
			}
		};

		_velocitySeries = new List<ChartSeries>
		{
			new ChartSeries
			{
				Name = "Velocity",
				Data = closestAsteroids.Select(a => Math.Round((double)(a.Velocity), 2)).ToArray()
			}
		};

		// Size distribution
		var small = _filteredAsteroids.Count(a => a.Diameter < 100);
		var medium = _filteredAsteroids.Count(a => a.Diameter >= 100 && a.Diameter < 500);
		var large = _filteredAsteroids.Count(a => a.Diameter >= 500 && a.Diameter < 1000);
		var veryLarge = _filteredAsteroids.Count(a => a.Diameter >= 1000);

		_sizeSeries = [small,
			medium,
			large,
			veryLarge];

		_pieLabels = [
			"Small (<100m)",
			"Medium (100-500m)",
			"Large (500-1000m)",
			"Very Large (>1000m)"];

		// Hazard distribution
		var hazardous = _filteredAsteroids.Count(a => a.IsHazardous);
		var safe = _filteredAsteroids.Count - hazardous;

		_hazardSeries = [hazardous, safe];
		_donutLabels = [
			"Potentially Hazardous",
			"Non-Hazardous"];

		// Distance vs Velocity correlation (scatter-like using sorted data)
		var correlationData = _filteredAsteroids
			.OrderBy(a => a.DistanceFromEarth)
			.Take(50)
			.ToList();

		_scatterLabels = correlationData
		.Select(a => $"{Math.Round((double)(a.DistanceFromEarth / 1_000_000m), 1)}M km")
		.ToArray();

		_scatterSeries = new List<ChartSeries>
		{
			new ChartSeries
			{
				Name = "Velocity",
				Data = correlationData.Select(a => Math.Round((double)a.Velocity, 0)).ToArray()
			}
		};

		_scatterChartOptions.InterpolationOption =
		correlationData.Count >= 4
		? InterpolationOption.NaturalSpline
		: InterpolationOption.Straight;

		StateHasChanged();
	}

	private void ApplyFilters()
	{
		_filteredAsteroids = _asteroids;

		if (!string.IsNullOrWhiteSpace(_searchString))
		{
			_filteredAsteroids = _filteredAsteroids.Where(a => a.Name
				.Contains(_searchString, StringComparison.OrdinalIgnoreCase) 
				|| a.Id.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
				.ToList();
		}

		if (_distanceRange != "all")
		{
			var parts = _distanceRange.Split('-');
			var min = double.Parse(parts[0]);
			var max = double.Parse(parts[1]);
			
			_filteredAsteroids = _filteredAsteroids
				.Where(a =>
				{
					var distanceInMillions = (double)(a.DistanceFromEarth / 1000000m);
					return distanceInMillions >= min && distanceInMillions <= max;
				})
				.ToList();
		}

		if (_velocityRange != "all")
		{
			var parts = _velocityRange.Split('-');
			var min = double.Parse(parts[0]);
			var max = double.Parse(parts[1]);
			
			_filteredAsteroids = _filteredAsteroids
				.Where(a => (double)a.Velocity >= min && (double)a.Velocity <= max)
				.ToList();
		}

		UpdateCharts();
		UpdateStatistics();
	}
}