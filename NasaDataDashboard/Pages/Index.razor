@page "/"

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h3" Class="mb-4 text-center font-weight-bold">Near-Earth Object Tracker</MudText>
@if (_loading)
{
	<MudProgressLinear Indeterminate="true" />
	<MudShimmer Lines="6" />
} else
{
	<MudGrid>
		<MudItem xs="12" md="6">
			<MudCard>
				<MudCardHeader><MudText Typo="Typo.h6">Closest Asteroids</MudText></MudCardHeader>
				<MudCardContent>
					<MudChart ChartType="ChartType.Bar"
					ChartSeries="@_distanceSeries"
					XAxisLabels="@_xAxisLabels"
					Height="500px"
					Width="100%"
					ChartOptions="_chartOptions" />
				</MudCardContent>
			</MudCard>
		</MudItem>

		<MudItem xs="12" md="6">
			<MudCard>
				<MudCardHeader><MudText Typo="Typo.h6">Asteroid Velocity</MudText></MudCardHeader>
					<MudCardContent>
						<MudChart ChartType="ChartType.Line"
						ChartSeries="@_velocitySeries"
						XAxisLabels="@_xAxisLabels"
						Height="500px"
						Width="100%"
						ChartOptions="_chartOptions" />
					</MudCardContent>
			</MudCard>
		</MudItem>
	</MudGrid>
}

@inject Data.Services.NasaApiService nasaApiService

@code
{
	private List<ChartSeries> _distanceSeries = new();
	private List<ChartSeries> _velocitySeries = new();

	private bool _loading = true;
	private List<Data.Objects.AsteroidData> _asteroids = new();
	private string[] _xAxisLabels = Array.Empty<string>();

	private ChartOptions _chartOptions = new ChartOptions()
	{
		YAxisTicks = 10,
		YAxisLines = true,
		XAxisLines = true,
		InterpolationOption = InterpolationOption.Straight,
		YAxisFormat = "N2",
		ShowLegend = false // Hide the legend since we have custom labels
	};

	protected override async Task OnInitializedAsync()
	{
		_asteroids = await nasaApiService.GetNeoAsync();
		_loading = false;

		// Sort by distance and take the 10 closest asteroids
		var closestAsteroids = _asteroids
			.OrderBy(a => a.DistanceFromEarth)
			.Take(10)
			.ToList();

		// Create x axis labels using asteroid IDs
		_xAxisLabels = closestAsteroids.Select(a => a.Id).ToArray();

		// Create chart data, convert distance from km to millions of km
		_distanceSeries = new List<ChartSeries>
		{
			new ChartSeries
			{
				Name = "Distance",
				Data = closestAsteroids.Select(a => Math.Round((double)(a.DistanceFromEarth / 1000000m), 2)).ToArray()
			}
		};

		_velocitySeries = new List<ChartSeries>
		{
			new ChartSeries
			{
				Name = "Velocity",
				Data = closestAsteroids.Select(a => Math.Round((double)(a.Velocity), 2)).ToArray()
			}
		};
	}
}